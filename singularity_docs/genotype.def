Bootstrap: docker
From: python:3.11-slim

%labels
    Author jalil.nourisa@gmail.com
    Description Genotype analysis image — plink2 + R (coloc, susieR) + python3 (scipy, pandas)

%post
    set -e
    export DEBIAN_FRONTEND=noninteractive

    # ── System packages ───────────────────────────────────────────────────────
    apt-get update -qq && apt-get install -y --no-install-recommends \
        wget curl unzip \
        ca-certificates \
        r-base r-base-dev \
        libcurl4-openssl-dev \
        libssl-dev \
        libxml2-dev \
        libfontconfig1-dev \
        libharfbuzz-dev \
        libfribidi-dev \
        libfreetype6-dev \
        libpng-dev \
        libtiff5-dev \
        libjpeg-dev \
        zlib1g-dev \
        libbz2-dev \
        liblzma-dev \
        tabix \
        bcftools \
        && rm -rf /var/lib/apt/lists/*

    # ── plink2 binary ─────────────────────────────────────────────────────────
    wget -q https://s3.amazonaws.com/plink2-assets/plink2_linux_avx2_latest.zip \
        -O /tmp/plink2.zip
    unzip /tmp/plink2.zip -d /tmp/plink2_dir
    mv /tmp/plink2_dir/plink2 /usr/local/bin/plink2
    chmod +x /usr/local/bin/plink2
    rm -rf /tmp/plink2.zip /tmp/plink2_dir

    # ── plink 1.9 (for --clump, not yet in plink2) ───────────────────────────
    wget -q https://s3.amazonaws.com/plink1-assets/plink_linux_x86_64_20231211.zip \
        -O /tmp/plink1.zip
    unzip /tmp/plink1.zip -d /tmp/plink1_dir
    mv /tmp/plink1_dir/plink /usr/local/bin/plink
    chmod +x /usr/local/bin/plink
    rm -rf /tmp/plink1.zip /tmp/plink1_dir

    # ── Python packages ───────────────────────────────────────────────────────
    pip install --no-cache-dir \
        pandas \
        numpy \
        scipy \
        requests \
        pyarrow \
        matplotlib \
        seaborn \
        tqdm

    # ── R packages ────────────────────────────────────────────────────────────
    Rscript -e "
        options(repos = list(CRAN='https://cloud.r-project.org/'))
        install.packages(c('data.table', 'optparse', 'R.utils'))
        install.packages('coloc')
        install.packages('susieR')
    "

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

%runscript
    exec python3 "$@"

%help
    Genotype analysis image for SNP-level analyses.

    Includes:
        plink2  — LD pruning, basic GWAS, allele frequency
        plink   — --clump for LD-based SNP clumping
        R       — coloc (colocalization), susieR (fine-mapping), data.table
        python3 — pandas, scipy, numpy, requests, matplotlib, seaborn, tqdm

    Usage:
        singularity exec \
            --bind /vol/projects:/vol/projects \
            /vol/projects/BIIM/agentic_central/singularity/genotype.sif \
            python3 /your_script.py

        singularity exec \
            --bind /vol/projects:/vol/projects \
            /vol/projects/BIIM/agentic_central/singularity/genotype.sif \
            Rscript /your_script.R
