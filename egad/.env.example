# Framework paths — not shipped with this repo, point these at your own copies.
CIIM_DATALAKE_DIR=/vol/projects/CIIM/agentic/datalake
CIIM_SINGULARITY_DIR=/vol/projects/CIIM/singularity
# Where temp/ (per-task workspace) physically lives. Default: temp/ under the
# host project root — install.sh resolves this to an absolute path.
CIIM_TEMP_DIR=temp

OPENGWAS_TOKEN=NA
NGROK_AUTHTOKEN=NA
GWDG_API_KEY=NA
CLAUDE_CODE_OAUTH_TOKEN=NA
SYNAPSE_AUTH_TOKEN=NA

# memory_bank feedback capture (see memory_bank/README.md) — client side:
# which server to talk to, and this client's own identity.
MEMORY_BANK_URL=NA
MEMORY_BANK_TOKEN=NA
