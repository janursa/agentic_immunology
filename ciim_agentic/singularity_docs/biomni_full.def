Bootstrap: docker
From: python:3.11-slim

%labels
    Author jalil.nourisa@gmail.com
    Description Biomni – Full image (core stack + all bio tools from bio_env.yml)

%post
    set -e

    # ─── System dependencies + CLI bioinformatics tools (apt) ────────────────
    apt-get update -qq && apt-get install -y --no-install-recommends \
        build-essential \
        git \
        curl \
        wget \
        ca-certificates \
        libgomp1 \
        libgl1-mesa-glx \
        libhdf5-dev \
        libgsl-dev \
        libz-dev \
        libbz2-dev \
        liblzma-dev \
        libncurses5-dev \
        libssl-dev \
        libffi-dev \
        libhts-dev \
        pkg-config \
        r-base \
        samtools \
        bedtools \
        ncbi-blast+ \
        bowtie2 \
        bwa \
        fastqc \
        trimmomatic \
        mafft \
        && rm -rf /var/lib/apt/lists/*

    # ─── Core scientific stack (mirrors environment.yml) ─────────────────────
    pip install --no-cache-dir \
        "numpy==2.1" \
        pandas \
        matplotlib \
        matplotlib-venn \
        scipy \
        statsmodels \
        scikit-learn \
        tqdm \
        seaborn \
        networkx \
        requests \
        pyyaml \
        beautifulsoup4 \
        lxml \
        python-dotenv

    # ─── LangChain / LangGraph ────────────────────────────────────────────────
    pip install --no-cache-dir \
        langchain \
        "langgraph==0.3.18" \
        langchain-openai \
        langchain-anthropic \
        langchain-ollama \
        langchain-community \
        openai

    # ─── Transformer / NLP utilities ─────────────────────────────────────────
    pip install --no-cache-dir \
        transformers \
        sentencepiece

    # ─── Biomni runtime dependencies ─────────────────────────────────────────
    pip install --no-cache-dir \
        mcp \
        tooluniverse \
        pydantic \
        gradio

    # ─── Bio Python packages (bio_env.yml pip section) ───────────────────────
    # Pre-install build deps so C-extension packages compile correctly
    pip install --no-cache-dir cython setuptools wheel

    # Re-install gcc right here — build-essential from above doesn't persist gcc
    # to /usr/bin in this fakeroot context
    apt-get update -qq && apt-get install -y --no-install-recommends gcc g++ && rm -rf /var/lib/apt/lists/*
    gcc --version

    # Packages that require --no-build-isolation (need pre-installed numpy/cython)
    pip install --no-cache-dir --no-build-isolation \
        pyranges \
        pyscenic

    # Remaining bio packages
    pip install --no-cache-dir \
        scanpy \
        biopython \
        biopandas \
        biotite \
        opencv-python-headless \
        rdkit \
        lifelines \
        scikit-image \
        googlesearch-python \
        PyPDF2 \
        gget \
        faiss-cpu \
        cellxgene-census \
        scikit-bio \
        pymed \
        arxiv \
        scholarly \
        umap-learn \
        scrublet \
        scvelo \
        scvi-tools \
        pyliftover \
        "pytdc==0.4.0" \
        pysam \
        pyfaidx \
        igraph \
        cooler \
        trackpy \
        cellpose \
        python-libsbml \
        cobra \
        reportlab \
        hmmlearn \
        msprime \
        tskit \
        cyvcf2 \
        pykalman \
        python-louvain \
        gseapy \
        harmony-pytorch \
        PyMassSpec \
        celltypist \
        decoupler

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    # Fixed data path — data is pre-downloaded here once; never re-downloaded
    export BIOMNI_PATH=/biomni/data
    # Add bind-mounted biomni to Python path at runtime
    export PYTHONPATH=/biomni:${PYTHONPATH:-}

%runscript
    exec python "$@"

%help
    Biomni full image – core Python stack + all bio tools.

    Quick start (bind-mount the biomni source + host SSL cert):
        singularity exec \
            --bind /vol/projects/CIIM/agentic_central/biomni:/biomni \
            --bind /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem:/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem \
            --env OPENAI_API_KEY=$OPENAI_API_KEY \
            biomni_full.sif python /your_script.py

    NOTE: The SSL cert bind is required on this host because SSL_CERT_FILE
    is set in the environment and points to a host-only path.

    Required environment variables:
        export OPENAI_API_KEY=sk-...
        export ANTHROPIC_API_KEY=sk-ant-...
