Bootstrap: docker
From: nvidia/cuda:12.3.2-devel-ubuntu22.04

%labels
    Author jalil.nourisa@gmail.com
    Description llama.cpp built from source (CUDA 12.3) for Gemma 4

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -qq && apt-get install -y --no-install-recommends \
        cmake git build-essential python3 python3-pip wget curl ca-certificates \
        libcurl4-openssl-dev && \
    rm -rf /var/lib/apt/lists/*

    # Clone latest llama.cpp
    cd /opt
    git clone --depth=1 https://github.com/ggerganov/llama.cpp
    cd llama.cpp

    # Make CUDA stub available so linker can resolve libcuda.so.1
    ln -sf /usr/local/cuda/lib64/stubs/libcuda.so /usr/local/cuda/lib64/stubs/libcuda.so.1
    export LIBRARY_PATH=/usr/local/cuda/lib64/stubs:${LIBRARY_PATH}

    # Build with CUDA support; NO_VMM avoids VMM symbols not in older drivers
    cmake -B build \
        -DGGML_CUDA=ON \
        -DGGML_NATIVE=OFF \
        -DGGML_AVX512=OFF \
        -DGGML_CUDA_NO_VMM=ON \
        -DCMAKE_BUILD_TYPE=Release \
        -DLLAMA_CURL=ON
    cmake --build build --config Release -j$(nproc) --target llama-server

    # Install binaries and libraries
    cp build/bin/llama-server /usr/local/bin/
    find build -name "*.so*" -exec cp -P {} /usr/local/lib/ \; 2>/dev/null || true
    ldconfig

%environment
    export LD_LIBRARY_PATH=/usr/local/lib:${LD_LIBRARY_PATH}

%help
    llama.cpp server built from source with CUDA 12.3 (driver >= 545).
    Compatible with bioinf034 (A100) and all other cluster GPU nodes.

    Usage (start server with local model):
        singularity exec --nv \
            --bind /vol/projects:/vol/projects \
            --bind /home/jnourisa:/home/jnourisa \
            /vol/projects/CIIM/agentic_central/singularity/gemma4.sif \
            llama-server \
                -m /path/to/model.gguf \
                --host 0.0.0.0 --port 8080 --no-warmup

    Models:
        gemma-4-E4B-it-GGUF (~5GB VRAM): cached at ~/.cache/llama.cpp/
