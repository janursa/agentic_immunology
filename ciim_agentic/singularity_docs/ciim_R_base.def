Bootstrap: docker
From: rocker/r-ver:4.4.1

%labels
    Author jalil.nourisa@gmail.com
    Description CIIM R base — single-cell / bioinformatics R stack (Seurat v5, Signac, tidyverse, Bioconductor essentials)

%post
    set -e
    export DEBIAN_FRONTEND=noninteractive

    # ── System libraries (build deps for the R/Bioc stack) ────────────────────
    apt-get update -qq && apt-get install -y --no-install-recommends \
        build-essential gfortran \
        git wget curl unzip ca-certificates pkg-config cmake \
        libcurl4-openssl-dev libssl-dev libxml2-dev \
        libhdf5-dev \
        libglpk-dev libgsl-dev \
        libgeos-dev libfftw3-dev \
        libfontconfig1-dev libharfbuzz-dev libfribidi-dev \
        libfreetype6-dev libpng-dev libtiff5-dev libjpeg-dev \
        libcairo2-dev libxt-dev \
        zlib1g-dev libbz2-dev liblzma-dev \
        && rm -rf /var/lib/apt/lists/*

    # rocker/r-ver sets repos to the Posit P3M binary mirror (jammy) → fast,
    # precompiled CRAN installs. Confirm and keep that behaviour.
    echo "options(Ncpus = parallel::detectCores())" >> /usr/local/lib/R/etc/Rprofile.site

    # ── CRAN packages (binary via P3M) ────────────────────────────────────────
    Rscript -e '
        pkgs <- c(
          # core / IO / utils
          "Matrix", "data.table", "R.utils", "optparse", "BiocManager",
          "remotes", "hdf5r", "jsonlite", "Rcpp",
          # tidyverse + plotting
          "tidyverse", "ggplot2", "ggrepel", "patchwork", "cowplot",
          "pheatmap", "RColorBrewer", "viridis",
          # graph / single-cell (Signac installed later via BiocManager — it
          # depends on Bioconductor packages installed in the next step)
          "igraph", "Seurat", "SeuratObject",
          # meta-analysis (DerSimonian-Laird with correct tau2 floor,
          # unlike the statsmodels combine_effects implementation)
          "metafor"
        )
        install.packages(pkgs)
        miss <- pkgs[!pkgs %in% rownames(installed.packages())]
        if (length(miss)) { cat("FAILED CRAN:", paste(miss, collapse=", "), "\n"); quit(status=1) }
    '

    # ── Bioconductor essentials (+ Signac deps) + Signac ──────────────────────
    # BiocManager::install resolves BOTH CRAN and Bioconductor repos, so it can
    # build Signac together with its Bioc dependencies.
    Rscript -e '
        bioc <- c(
          # Signac Bioconductor deps
          "BiocGenerics", "S4Vectors", "IRanges",
          "GenomeInfoDb", "GenomicRanges", "Rsamtools",
          # general bioinformatics essentials
          "SingleCellExperiment", "SummarizedExperiment",
          "AUCell", "limma", "edgeR", "ComplexHeatmap",
          # single-cell / multiome (needs the Bioc deps above)
          "Signac"
        )
        BiocManager::install(bioc, update = FALSE, ask = FALSE)
        miss <- bioc[!bioc %in% rownames(installed.packages())]
        if (length(miss)) { cat("FAILED Bioc:", paste(miss, collapse=", "), "\n"); quit(status=1) }
    '

    # sanity: the example deps must load
    Rscript -e 'suppressMessages({library(Seurat); library(Signac); library(ggplot2); library(igraph); library(metafor)}); cat("core libs OK\n")'

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

%runscript
    exec Rscript "$@"

%help
    CIIM R base — single-cell / bioinformatics R analysis image.

    R 4.4.1 (rocker/r-ver) with a precompiled CRAN + Bioconductor stack.

    Key packages:
        Seurat (v5), SeuratObject, Signac   — single-cell / multiome (RNA + ATAC)
        tidyverse, ggplot2, ggrepel, patchwork, cowplot, pheatmap, ComplexHeatmap
        Matrix, igraph, data.table, hdf5r, R.utils, optparse
        SingleCellExperiment, SummarizedExperiment, GenomicRanges, Rsamtools
        AUCell, limma, edgeR
        metafor                             — meta-analysis (DerSimonian-Laird, REML, etc.)

    Usage:
        singularity exec \
            --bind /vol/projects:/vol/projects \
            /vol/projects/BIIM/agentic_immunology/singularity/ciim_R_base.sif \
            Rscript /your_script.R
